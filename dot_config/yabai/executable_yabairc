#!/usr/bin/env sh

RETINA_DISPLAY_INDEX=1
RETINA_SPACE_LABEL="retina"

yabai -m config layout bsp
yabai -m config auto_balance off
yabai -m config split_ratio 0.50

yabai -m config window_gap 0
yabai -m config top_padding 32
yabai -m config bottom_padding 0
yabai -m config left_padding 1
yabai -m config right_padding 1

yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

if command -v sudo >/dev/null 2>&1; then
  sudo yabai --load-sa >/dev/null 2>&1 || true
fi

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
yabai -m signal --add event=display_added action="$HOME/.config/yabai/scripts/init-spaces.sh auto $RETINA_SPACE_LABEL"
yabai -m signal --add event=display_removed action="$HOME/.config/yabai/scripts/init-spaces.sh auto $RETINA_SPACE_LABEL"
yabai -m signal --add event=space_changed action="$HOME/.config/yabai/scripts/apply-padding.sh auto"
yabai -m signal --add event=display_changed action="$HOME/.config/yabai/scripts/apply-padding.sh auto"
yabai -m signal --add event=display_added action="$HOME/.config/yabai/scripts/sync-sketchybar.sh auto"
yabai -m signal --add event=display_removed action="$HOME/.config/yabai/scripts/sync-sketchybar.sh auto"
yabai -m signal --add event=display_added action="$HOME/.config/yabai/scripts/load-rules.sh $RETINA_SPACE_LABEL"
yabai -m signal --add event=display_removed action="$HOME/.config/yabai/scripts/load-rules.sh $RETINA_SPACE_LABEL"

yabai -m signal --add event=space_changed action="sketchybar --trigger spaces_refresh"
yabai -m signal --add event=display_changed action="sketchybar --trigger spaces_refresh"
yabai -m signal --add event=window_created action="sketchybar --trigger spaces_refresh"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger spaces_refresh"
yabai -m signal --add event=window_focused action="sketchybar --trigger spaces_refresh"
yabai -m signal --add event=window_moved action="sketchybar --trigger spaces_refresh"

$HOME/.config/yabai/scripts/init-spaces.sh auto "$RETINA_SPACE_LABEL"
$HOME/.config/yabai/scripts/apply-padding.sh auto
$HOME/.config/yabai/scripts/load-rules.sh "$RETINA_SPACE_LABEL"

if command -v borders >/dev/null 2>&1; then
  borders active_color=0xffDFC57B inactive_color=0xff494d64 width=5.0 >/dev/null 2>&1 &
fi

"$HOME/.config/yabai/scripts/sync-sketchybar.sh" auto
