#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

RETINA_DISPLAY_INDEX="${RETINA_DISPLAY_INDEX:-}"
EXTERNAL_DISPLAY_INDICES=""

if command -v yabai >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  if [ -z "$RETINA_DISPLAY_INDEX" ] || ! yabai -m query --displays | jq -e --arg idx "$RETINA_DISPLAY_INDEX" '.[] | select((.index|tostring) == $idx)' >/dev/null 2>&1; then
    resolved_index="$(yabai -m query --displays | jq -r '.[] | select(.id == 1) | .index' | head -n 1)"
    if [ -n "$resolved_index" ]; then
      RETINA_DISPLAY_INDEX="$resolved_index"
    else
      RETINA_DISPLAY_INDEX=1
    fi
  fi

  EXTERNAL_DISPLAY_INDICES="$(yabai -m query --displays 2>/dev/null | jq -r --arg retina "$RETINA_DISPLAY_INDEX" '.[] | select((.index|tostring) != $retina) | .index' | paste -sd, -)"
else
  [ -z "$RETINA_DISPLAY_INDEX" ] && RETINA_DISPLAY_INDEX=1
fi

INDEX_DISPLAY_INDICES="$RETINA_DISPLAY_INDEX"
if [ -n "$EXTERNAL_DISPLAY_INDICES" ]; then
  INDEX_DISPLAY_INDICES="$INDEX_DISPLAY_INDICES,$EXTERNAL_DISPLAY_INDICES"
fi

sketchybar --add event spaces_refresh

sketchybar --bar display=all \
               height=28 \
               color=0x00000000 \
               blur_radius=10 \
               corner_radius=14 \
               topmost=window \
               sticky=on \
               margin=0 \
               y_offset=0 \
               font_smoothing=on \
               notch_width=220 \
               notch_display_height=28

default=(
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Regular:12.0"
  icon.padding_right=5
  icon.padding_left=5
)
sketchybar --default "${default[@]}"

workspaces="$(yabai -m query --spaces | jq -r 'sort_by(.index) | .[] | if (.label != null and .label != "") then .label else (.index|tostring) end')"
workspaces_inline="$(printf '%s' "$workspaces" | tr '\n' ' ')"

[ -f "$CONFIG_DIR/sketchybarrc.retina" ] && . "$CONFIG_DIR/sketchybarrc.retina"
[ -f "$CONFIG_DIR/sketchybarrc.external" ] && . "$CONFIG_DIR/sketchybarrc.external"

sketchybar --update
