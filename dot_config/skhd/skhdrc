:: default

alt - return : $HOME/.config/yabai/scripts/open-or-focus-kitty.sh

cmd - h : true
cmd + alt - h : true

alt - 0x2C : yabai -m space --layout bsp
alt - 0x2B : yabai -m space --layout stack

alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

alt + shift - 0x1B : yabai -m window --ratio rel:-0.05
alt + shift - 0x18 : yabai -m window --ratio rel:+0.05

alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10
alt - r : $HOME/.config/yabai/scripts/focus-retina-space.sh

alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9
alt + shift - 0 : yabai -m window --space 10
alt + shift - r : $HOME/.config/yabai/scripts/move-window-retina-space.sh

alt - tab : yabai -m space --focus recent
alt + shift - tab : $HOME/.config/yabai/scripts/move-space-next-display.sh

:: service
alt + shift - 0x29 ; service

service < escape : yabai --restart-service && skhd --reload ; default
service < r : yabai -m space --layout bsp && yabai -m space --balance ; default
service < f : $HOME/.config/yabai/scripts/toggle-space-layout.sh ; default
service < backspace : $HOME/.config/yabai/scripts/close-all-windows-but-current.sh ; default

service < alt + shift - h : yabai -m window --warp west ; default
service < alt + shift - j : yabai -m window --warp south ; default
service < alt + shift - k : yabai -m window --warp north ; default
service < alt + shift - l : yabai -m window --warp east ; default

service < down : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 6)'
service < up : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 6)'
service < shift - down : osascript -e 'set volume output volume 0' ; default
